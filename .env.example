# App
PORT=3000
NODE_ENV=development

# Banco de dados (MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=condly
MYSQL_PASSWORD=condly
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=condly
DATABASE_URL=mysql://condly:condly@localhost:3306/condly

# JWT
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1d

# Integração com a portaria Condly (header x-api-key)
CONDLY_PORTARIA_API_KEY=troque-esta-chave

# Firebase: caminho do JSON da service account (Console > Configurações > Contas de serviço).
# Se o arquivo não existir, a API sobe sem notificações push.
FIREBASE_SERVICE_ACCOUNT_PATH=credentials/firebase-service-account.json

# Usuário admin criado pelo seed
ADMIN_EMAIL=admin@condly.com
ADMIN_PASSWORD=admin123
